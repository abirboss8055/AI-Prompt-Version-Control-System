# ==========================================
# Dependencies & Package Managers
# ==========================================
node_modules/
*/node_modules/
.pnpm-store/
.yarn/cache/
.yarn/unplugged/
.yarn/build-state.yml
.yarn/install-state.gz

# ==========================================
# Environment & Sensitive Credentials (DO NOT COMMIT)
# ==========================================
.env
.env.*
*.env
*.env.local
*.env.development.local
*.env.test.local
*.env.production.local
server/.env
client/.env

# Always allow committing the template example files
!.env.example
!server/.env.example
!client/.env.example

# ==========================================
# Production Builds & Bundler Outputs
# ==========================================
dist/
build/
client/dist/
client/build/
.next/
out/
.vite/
client/.vite/

# ==========================================
# Prisma & Local Databases
# ==========================================
*.sqlite
*.sqlite3
*.db
*.db-journal
server/prisma/*.db
server/prisma/*.sqlite

# ==========================================
# Logs & Diagnostic Outputs
# ==========================================
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# ==========================================
# OS Files & System Metadata
# ==========================================
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
[Dd]esktop.ini

# ==========================================
# IDE & Code Editor Configurations
# ==========================================
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
